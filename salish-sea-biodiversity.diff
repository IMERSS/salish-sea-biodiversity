diff --git a/scripts/collect-projects.js b/scripts/collect-projects.js
new file mode 100644
index 0000000..20f98d0
--- /dev/null
+++ b/scripts/collect-projects.js
@@ -0,0 +1,176 @@
+/* eslint-env node */
+
+"use strict";
+
+/*
+ * Collects the boundary GeoJSON and markdown description from the top level of each subsidiary project repository
+ * listed in projects.json, and writes them to data/projects.json for the Hugo build to render onto the index map.
+ *
+ * Usage:
+ *   node scripts/collect-projects.js                 - fetch from each repository's default branch on GitHub
+ *   node scripts/collect-projects.js --local <dir>   - read from local checkouts held at <dir>/<repository name>
+ *
+ * If a project's files cannot be retrieved, any entry previously collected for it is retained so that a transient
+ * failure does not remove the project from the map.
+ */
+
+const fs = require("fs/promises");
+const path = require("path");
+
+const rootDir = path.resolve(__dirname, "..");
+const configPath = path.join(rootDir, "projects.json");
+const outputPath = path.join(rootDir, "data", "projects.json");
+
+/**
+ * Parse a GitHub repository URL into its owner and repository name.
+ * @param {String} repoUrl - A repository URL such as `https://github.com/IMERSS/saanich-peninsula-flora`.
+ * @return {Object} An object with members `owner` and `name` holding the repository's owner and name.
+ */
+const parseRepoUrl = function (repoUrl) {
+    const match = /^https:\/\/github\.com\/([^/]+)\/([^/]+?)(?:\.git)?\/?$/.exec(repoUrl.trim());
+    if (match) {
+        return {owner: match[1], name: match[2]};
+    } else {
+        throw new Error("Cannot parse GitHub repository URL " + repoUrl);
+    }
+};
+
+/**
+ * Compute the URL of the GitHub Pages site published from a repository's docs/ directory.
+ * @param {Object} repo - A parsed repository as returned from `parseRepoUrl`.
+ * @return {String} The base URL of the repository's published site, ending in a slash.
+ */
+const pagesUrl = function (repo) {
+    const host = repo.owner.toLowerCase() + ".github.io";
+    // A repository named after the Pages host is published at the root of that host
+    return repo.name.toLowerCase() === host ? "https://" + host + "/" : "https://" + host + "/" + repo.name + "/";
+};
+
+/**
+ * Read a file from the top level of a project repository, either from GitHub or from a local checkout.
+ * @param {Object} repo - A parsed repository as returned from `parseRepoUrl`.
+ * @param {String} fileName - The name of the file at the top level of the repository.
+ * @param {String|null} localDir - A directory holding local checkouts of the repositories, or null to fetch from GitHub.
+ * @return {Promise<String>} A promise for the text content of the file.
+ */
+const readProjectFile = async function (repo, fileName, localDir) {
+    if (localDir) {
+        return fs.readFile(path.join(localDir, repo.name, fileName), "utf8");
+    } else {
+        const url = "https://raw.githubusercontent.com/" + repo.owner + "/" + repo.name + "/HEAD/" + fileName;
+        const response = await fetch(url);
+        if (response.ok) {
+            return response.text();
+        } else {
+            throw new Error("HTTP " + response.status + " fetching " + url);
+        }
+    }
+};
+
+/**
+ * Normalise parsed GeoJSON into a FeatureCollection holding at least one feature.
+ * @param {Object} geojson - Parsed GeoJSON, which may be a FeatureCollection, a Feature or a bare geometry.
+ * @return {Object} A GeoJSON FeatureCollection.
+ */
+const toFeatureCollection = function (geojson) {
+    let features;
+    if (geojson.type === "FeatureCollection") {
+        features = geojson.features;
+    } else if (geojson.type === "Feature") {
+        features = [geojson];
+    } else {
+        features = [{type: "Feature", properties: {}, geometry: geojson}];
+    }
+    if (Array.isArray(features) && features.length > 0) {
+        return {type: "FeatureCollection", features};
+    } else {
+        throw new Error("Boundary GeoJSON holds no features");
+    }
+};
+
+/**
+ * Derive a project title from its markdown description, using the first level-one heading if there is one.
+ * @param {String} markdown - The project's markdown description.
+ * @param {String} fallback - The title to use if the markdown has no level-one heading.
+ * @return {String} The project's title.
+ */
+const titleFromMarkdown = function (markdown, fallback) {
+    const match = /^#\s+(.+?)\s*#*\s*$/m.exec(markdown);
+    return match ? match[1] : fallback;
+};
+
+/**
+ * Collect the boundary and description of a single project.
+ * @param {String} repoUrl - The project's GitHub repository URL.
+ * @param {Object} config - The parsed contents of projects.json.
+ * @param {String|null} localDir - A directory holding local checkouts of the repositories, or null to fetch from GitHub.
+ * @return {Promise<Object>} A promise for the project's record in data/projects.json.
+ */
+const collectProject = async function (repoUrl, config, localDir) {
+    const repo = parseRepoUrl(repoUrl);
+    const [boundaryText, description] = await Promise.all([
+        readProjectFile(repo, config.boundaryFile, localDir),
+        readProjectFile(repo, config.descriptionFile, localDir)
+    ]);
+    return {
+        id: repo.name,
+        title: titleFromMarkdown(description, repo.name),
+        repoUrl: "https://github.com/" + repo.owner + "/" + repo.name,
+        siteUrl: pagesUrl(repo),
+        description,
+        boundary: toFeatureCollection(JSON.parse(boundaryText))
+    };
+};
+
+/**
+ * Read the previously collected projects, if any, indexed by repository URL.
+ * @return {Promise<Object<String, Object>>} A promise for a map of repository URL to previously collected project record.
+ */
+const readPrevious = async function () {
+    let previous = {};
+    try {
+        const records = JSON.parse(await fs.readFile(outputPath, "utf8"));
+        previous = Object.fromEntries(records.map(record => [record.repoUrl, record]));
+    } catch (e) {
+        if (e.code !== "ENOENT") {
+            console.warn("Ignoring unreadable " + outputPath + ": " + e.message);
+        }
+    }
+    return previous;
+};
+
+/**
+ * Collect all projects listed in projects.json and write them to data/projects.json.
+ * @return {Promise} A promise which resolves when data/projects.json has been written.
+ */
+const main = async function () {
+    const localIndex = process.argv.indexOf("--local");
+    const localDir = localIndex === -1 ? null : path.resolve(process.argv[localIndex + 1] ?? "..");
+    const config = JSON.parse(await fs.readFile(configPath, "utf8"));
+    const previous = await readPrevious();
+
+    const results = await Promise.allSettled(config.projects.map(repoUrl => collectProject(repoUrl, config, localDir)));
+    const records = results.flatMap((result, i) => {
+        const repoUrl = config.projects[i];
+        let record;
+        if (result.status === "fulfilled") {
+            record = result.value;
+            console.log("Collected " + record.title + " from " + repoUrl);
+        } else {
+            const prior = previous["https://github.com/" + Object.values(parseRepoUrl(repoUrl)).join("/")];
+            console.warn("Failed to collect " + repoUrl + ": " + result.reason.message +
+                (prior ? " - retaining previously collected version" : " - omitting from map"));
+            record = prior;
+        }
+        return record ? [record] : [];
+    });
+
+    await fs.mkdir(path.dirname(outputPath), {recursive: true});
+    await fs.writeFile(outputPath, JSON.stringify(records, null, 2) + "\n");
+    console.log("Wrote " + records.length + " project(s) to " + path.relative(rootDir, outputPath));
+};
+
+main().catch(e => {
+    console.error(e);
+    process.exitCode = 1;
+});
diff --git a/static/js/project-map.js b/static/js/project-map.js
new file mode 100644
index 0000000..849c412
--- /dev/null
+++ b/static/js/project-map.js
@@ -0,0 +1,165 @@
+/* global maplibregl */
+
+"use strict";
+
+/*
+ * Renders the index map of subsidiary project boundaries. Hovering a project shows its description, and clicking it
+ * browses to the project's site. On devices without hover, a tap shows the description with a link to the site.
+ */
+
+const imerssProjectMapDefaults = {
+    // Overview of the Salish Sea as [[west, south], [east, north]]
+    bounds: [[-125.3, 47.0], [-122.0, 50.3]],
+    tiles: "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
+    attribution: "Tiles &copy; Esri &mdash; Source: Esri, Maxar, Earthstar Geographics, and the GIS User Community",
+    colour: "#FDF2CE"
+};
+
+/**
+ * Merge the boundaries of all projects into a single FeatureCollection, tagging each feature with its project's index.
+ * @param {Object[]} projects - Project records, each with a `boundary` member holding a GeoJSON FeatureCollection.
+ * @return {Object} A GeoJSON FeatureCollection whose features each have an `id` equal to their project's index.
+ */
+const imerssProjectFeatures = function (projects) {
+    const features = projects.flatMap((project, index) => project.boundary.features.map(feature => ({
+        type: "Feature",
+        id: index,
+        properties: {projectIndex: index},
+        geometry: feature.geometry
+    })));
+    return {type: "FeatureCollection", features};
+};
+
+/**
+ * Build the HTML shown in the popup for a project.
+ * @param {Object} project - A project record with members `descriptionHtml` and `siteUrl`.
+ * @param {Boolean} withLink - Whether to include an explicit link to the project's site.
+ * @return {String} The popup's HTML.
+ */
+const imerssProjectPopupHtml = function (project, withLink) {
+    const link = withLink ? "<p class=\"imerss-project-popup-link\"><a href=\"" + project.siteUrl + "\">Visit project site &rarr;</a></p>" : "";
+    return project.descriptionHtml + link;
+};
+
+/**
+ * Create the project map within a container.
+ * @param {HTMLElement} container - The element to render the map into.
+ * @param {Object[]} projects - Project records as rendered by the `project-map.html` partial.
+ * @param {Object} [options] - Options overriding `imerssProjectMapDefaults`.
+ * @return {maplibregl.Map} The created map.
+ */
+const imerssProjectMap = function (container, projects, options) {
+    const opts = {...imerssProjectMapDefaults, ...options};
+    const canHover = window.matchMedia("(hover: hover)").matches;
+    const map = new maplibregl.Map({
+        container,
+        bounds: opts.bounds,
+        style: {
+            version: 8,
+            sources: {
+                basemap: {
+                    type: "raster",
+                    tiles: [opts.tiles],
+                    tileSize: 256,
+                    attribution: opts.attribution
+                }
+            },
+            layers: [{id: "basemap", type: "raster", source: "basemap"}]
+        }
+    });
+    map.addControl(new maplibregl.NavigationControl({showCompass: false}), "top-right");
+
+    const popup = new maplibregl.Popup({
+        closeButton: !canHover,
+        closeOnClick: false,
+        maxWidth: "340px",
+        offset: 14,
+        // When hovering, the popup must not intercept the pointer, or the map would see it leave the project
+        className: "imerss-project-popup" + (canHover ? " imerss-project-popup-hover" : "")
+    });
+    let hoveredIndex = null;
+
+    /**
+     * Highlight a project and show its popup, or clear the highlight and popup.
+     * @param {Number|null} index - The index of the project to highlight, or null to clear any highlight.
+     * @param {maplibregl.LngLat} [lngLat] - The location at which to show the popup.
+     */
+    const setHovered = function (index, lngLat) {
+        if (hoveredIndex !== null) {
+            map.setFeatureState({source: "projects", id: hoveredIndex}, {hover: false});
+        }
+        hoveredIndex = index;
+        if (index !== null) {
+            map.setFeatureState({source: "projects", id: index}, {hover: true});
+            popup.setLngLat(lngLat);
+            if (!popup.isOpen()) {
+                popup.setHTML(imerssProjectPopupHtml(projects[index], !canHover)).addTo(map);
+            }
+        } else {
+            popup.remove();
+        }
+    };
+
+    map.on("load", () => {
+        map.addSource("projects", {type: "geojson", data: imerssProjectFeatures(projects)});
+        map.addLayer({
+            id: "project-fill",
+            type: "fill",
+            source: "projects",
+            paint: {
+                "fill-color": opts.colour,
+                "fill-opacity": ["case", ["boolean", ["feature-state", "hover"], false], 0.45, 0.2]
+            }
+        });
+        map.addLayer({
+            id: "project-outline",
+            type: "line",
+            source: "projects",
+            paint: {
+                "line-color": opts.colour,
+                "line-width": ["case", ["boolean", ["feature-state", "hover"], false], 3, 1.5]
+            }
+        });
+
+        map.on("mousemove", "project-fill", e => {
+            if (canHover) {
+                const index = e.features[0].properties.projectIndex;
+                if (index !== hoveredIndex) {
+                    popup.remove();
+                }
+                map.getCanvas().style.cursor = "pointer";
+                setHovered(index, e.lngLat);
+            }
+        });
+        map.on("mouseleave", "project-fill", () => {
+            if (canHover) {
+                map.getCanvas().style.cursor = "";
+                setHovered(null);
+            }
+        });
+        map.on("click", e => {
+            const features = map.queryRenderedFeatures(e.point, {layers: ["project-fill"]});
+            if (features.length > 0) {
+                const index = features[0].properties.projectIndex;
+                if (canHover) {
+                    window.location.href = projects[index].siteUrl;
+                } else {
+                    popup.remove();
+                    setHovered(index, e.lngLat);
+                }
+            } else {
+                setHovered(null);
+            }
+        });
+    });
+    return map;
+};
+
+document.addEventListener("DOMContentLoaded", () => {
+    document.querySelectorAll(".imerss-project-map").forEach(container => {
+        const dataElement = container.parentElement.querySelector(".imerss-project-map-data");
+        const projects = JSON.parse(dataElement?.textContent || "[]");
+        const bounds = JSON.parse(container.dataset.bounds || "null");
+        imerssProjectMap(container, projects, bounds ? {bounds} : {});
+    });
+});
